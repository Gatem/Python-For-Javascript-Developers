{
  "name": "python-for-js-devs",
  "private": true,
  "version": "1.0.0",
  "description": "Interactive Python course for JavaScript developers, with exercises that run real Python in the browser.",
  "author": "Sabry E. Farrag (https://www.linkedin.com/in/sabry-elsayed)",
  "license": "MIT",
  "homepage": "https://gatem.github.io/Python-For-Javascript-Developers/",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run src/lib",
    "test:exercises": "vitest run src/data"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "lucide-react": "^1.52.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.1.7",
    "@vitejs/plugin-react": "^4.5.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "puppeteer-core": "^25.12.0",
    "pyodide": "^314.0.7",
    "tailwindcss": "^4.1.7",
    "vite": "^6.3.5",
    "vitest": "^5.0.3"
  }
}
